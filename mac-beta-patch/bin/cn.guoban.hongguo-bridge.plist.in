<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent template. install.sh replaces @STATE@ with the real state dir
     and installs it to ~/Library/LaunchAgents/cn.guoban.hongguo-bridge.plist.
     KeepAlive restarts the bridge within seconds whenever it dies, so the app
     never sees the "发现片单暂时加载失败" toast from a missing bridge. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>cn.guoban.hongguo-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>@STATE@/venv/bin/python</string>
        <string>@STATE@/app/bridge.py</string>
        <string>--port</string>
        <string>8787</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>@STATE@/bridge.log</string>
    <key>StandardErrorPath</key>
    <string>@STATE@/bridge.log</string>
</dict>
</plist>
